generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id             String      @id @default(cuid())
  ownerId        String
  owner          Owner       @relation(fields: [ownerId], references: [id])
  street         String
  city           String
  zip            String
  size           String
  rent           Int
  availableFrom  DateTime
  description    String?
  maxPersons     Int         @default(2)
  petsAllowed    String      @default("domluva")
  smokingAllowed Boolean     @default(false)
  tenantPref     String      @default("bez preference")
  status         String      @default("new")
  photos         String[]
  adHeadline     String?
  adText         String?
  adStatus                 String      @default("pending")
  contactPhone             String?
  shortlistStripeSessionId String?     @unique
  shortlistPaidAt          DateTime?
  createdAt                DateTime    @default(now())
  applicants     Applicant[]
}

model Applicant {
  id                     String    @id @default(cuid())
  listingId              String
  listing                Listing   @relation(fields: [listingId], references: [id])
  name                   String
  email                  String
  phone                  String
  dateOfBirth            String?
  householdMembers       Json?
  message                String?
  income                 Int?
  employment             String?
  incomeProofUrl         String?
  personsCount           Int?
  hasPets                Boolean   @default(false)
  pets                   Json?
  previousLandlordEmail  String?
  previousLandlordPhone  String?
  moveReason             String?
  currentAddress         String?
  hasExecutions          Boolean   @default(false)
  executionDebt          String?
  executionComment       String?
  hasInsolvency          Boolean   @default(false)
  insolvencyDebt         String?
  insolvencyComment      String?
  additionalComment      String?
  // AI scoring
  score                  Int?
  scoringReason          String?
  aiNote                 String?
  vyjimecny              Boolean   @default(false)
  // Reference check
  referenceStatus        String?
  referenceCallId        String?
  referenceTranscript    String?
  referenceResult        String?
  referenceNote          String?
  referenceAttempts      Int       @default(0)
  referenceLastAttemptAt DateTime?
  // Registry checks
  ceeResult              String?
  isirResult             String?
  registryCheckedAt      DateTime?
  // Finální AI verdikt (konec kaskády): ultra_wow | wow | reject
  finalVerdict           String?
  finalReason            String?
  finalJudgedAt          DateTime?
  // Pipeline status
  status                 String    @default("new")
  gdprConsent            Boolean   @default(false)
  registryConsent        Boolean   @default(false)
  createdAt              DateTime  @default(now())
}

model Verification {
  id              String    @id @default(cuid())
  landlordName    String
  landlordEmail   String
  landlordPhone   String?
  tenantName      String
  tenantEmail     String
  package         String
  priceCzk        Int
  status          String    @default("pending_payment")
  stripeSessionId String?   @unique
  stripePaymentId String?
  consentToken    String    @unique @default(cuid())
  gdprConsent     Boolean   @default(false)
  registryConsent Boolean   @default(false)
  consentAt       DateTime?
  isirResult      String?
  ceeResult       String?
  adminNote       String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
